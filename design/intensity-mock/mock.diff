+// MOCK-UP: today's 15-minute readings, midnight to midnight, on one scale for all eight gauges.
+function Strip({ rs, now, top }: { rs: { t: number; v: number }[]; now: number; top: number }) {
+  const start = midnightOf(new Date(now))
+  const W = 96 * 3, H = 28
+  const upTo = Math.min(96, Math.ceil((now - start) / 900_000))
+  return (
+    <div className="im-strip">
+      <svg viewBox={`0 0 ${W} ${H + 1}`} preserveAspectRatio="none" role="img" aria-label="Rain in each 15 minutes today">
+        <rect x={0} y={H} width={upTo * 3} height={1} className="im-base" />
+        <rect x={upTo * 3} y={H} width={W - upTo * 3} height={1} className="im-future" />
+        {rs.map((r) => {
+          const slot = Math.round((r.t - start) / 900_000) - 1
+          if (r.v <= 0 || slot < 0 || slot >= 96) return null
+          const h = Math.max(1.5, (r.v / top) * H)
+          return <rect key={r.t} x={slot * 3} y={H - h} width={2} height={h} className="im-mark"><title>{`${mm(r.v)} in the 15 minutes to ${clock(r.t)}`}</title></rect>
+        })}
+      </svg>
+      <div className="im-axis"><span>midnight</span><span>6am</span><span>midday</span><span>6pm</span><span>midnight</span></div>
+    </div>
+  )
+}
